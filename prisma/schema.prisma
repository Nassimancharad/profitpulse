// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Shop {
  id          String     @id @default(cuid())
  shopDomain  String     @unique // e.g. mystore.myshopify.com
  accessToken String
  installedAt DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  paymentFeePct Float    @default(0)
  paymentFeeFixed Float  @default(0)

  products    Product[]
  orders      Order[]
  adSpends    AdSpend[]
  metaAdAccounts MetaAdAccount[]
  campaignProducts CampaignProduct[]
  metaCampaigns MetaCampaign[]
  shippingCostRules ShippingCostRule[]
  expenses    Expense[]
  syncStates  SyncState[]
}

model Product {
  id               String      @id @default(cuid())
  shop             Shop        @relation(fields: [shopId], references: [id])
  shopId           String
  shopifyProductId String
  title            String
  imageUrl         String?
  costPerUnit      Float?

  orderLines       OrderLine[]
  campaignProducts CampaignProduct[]

  @@unique([shopId, shopifyProductId])
}

model Order {
  id             String     @id @default(cuid())
  shop           Shop       @relation(fields: [shopId], references: [id])
  shopId         String
  shopifyOrderId String
  createdAt      DateTime
  shopifyUpdatedAt DateTime?
  totalPrice     Float
  shippingRevenue Float    @default(0)
  shippingCost    Float?
  shippingCountryCode String?
  refundedProductAmount Float @default(0)
  refundedShippingAmount Float @default(0)
  paymentFeeActual Float?

  orderLines     OrderLine[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopifyUpdatedAt])
}

model Expense {
  id        String   @id @default(cuid())
  shop      Shop?    @relation(fields: [shopId], references: [id])
  shopId    String?
  name      String
  amount    Float
  frequency String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

model ShippingCostRule {
  id            String   @id @default(cuid())
  shop          Shop     @relation(fields: [shopId], references: [id])
  shopId        String
  countryCode   String?
  minOrderValue Float?
  maxOrderValue Float?
  costAmount    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
}

model OrderLine {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String

  product     Product  @relation(fields: [productId], references: [id])
  productId   String

  quantity    Int
  lineRevenue Float // price * quantity
}

model AdSpend {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id])
  shopId      String
  adAccountId String

  date        DateTime
  campaignId  String?
  adsetId     String?
  adId        String?

  amountSpent Float

  @@index([shopId, adAccountId, date])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  shop       Shop     @relation(fields: [shopId], references: [id])
  shopId     String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  campaignId String
  createdAt  DateTime @default(now())

  @@unique([productId, campaignId])
  @@index([shopId, campaignId])
}

model MetaAdAccount {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id])
  shopId      String
  adAccountId String
  name        String?
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, adAccountId])
}

model MetaCampaign {
  id          String   @id @default(cuid())
  shop        Shop     @relation(fields: [shopId], references: [id])
  shopId      String
  adAccountId String
  campaignId  String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, campaignId])
  @@index([shopId, adAccountId])
}

enum SyncResource {
  SHOPIFY
  SHOPIFY_PAYMENTS
  META
}

enum SyncStatus {
  IDLE
  RUNNING
  OK
  ERROR
}

model SyncState {
  id             String       @id @default(cuid())
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId         String
  resource       SyncResource
  status         SyncStatus   @default(IDLE)
  lastSyncedAt   DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lockedAt       DateTime?
  lockExpiresAt  DateTime?
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([shopId, resource])
  @@index([shopId, status])
}
